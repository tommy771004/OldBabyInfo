# ── Auth.js v5 ────────────────────────────────────────────────────────────
# Session signing key. Generate one with: npx auth secret
AUTH_SECRET=

# Public origin of this deployment, no trailing slash. Auth.js builds every
# OAuth callback URL from it, and it must match what is registered with each
# provider exactly — scheme, host and port all count.
#   local dev : http://localhost:3000
#   production: https://old-baby-info.vercel.app
AUTH_URL=http://localhost:3000

# Canonical public origin used by sitemap.xml, robots.txt, canonical URLs,
# hreflang, Open Graph, and JSON-LD. Set this to the exact GSC property origin
# in production, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true when the app runs behind a proxy that terminates TLS
# (self-hosted, Cloudflare, nginx). Not needed on Vercel.
AUTH_TRUST_HOST=

# ── Google OAuth ──────────────────────────────────────────────────────────
# Redirect URI to register: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── LINE Login ────────────────────────────────────────────────────────────
# Channel ID and Channel secret of a LINE Login channel.
# Callback URL to register: {AUTH_URL}/api/auth/callback/line
# Step-by-step console setup: docs/line-login-setup.md
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# ── Data ──────────────────────────────────────────────────────────────────
# Neon Stock Listing and discussion readers
DATABASE_URL=

# ── Affiliate / promotion slots ───────────────────────────────────────────
# A separate PostgreSQL holding the shared `affiliates` table, written by
# other systems. Never NEXT_PUBLIC_, never sent to the browser, and never
# substituted with DATABASE_URL — that database has no `affiliates` table.
# Leave it empty and the homepage simply renders no promotion slot.
SUP_DATABASE_URL=

# Which project's rows to read out of that shared table. Must match exactly
# what the maintenance system writes into `affiliates.project_name`; a
# mismatch yields an empty slot rather than another project's partners.
# Defaults to old-baby-info when unset.
AFFILIATE_PROJECT_NAME=old-baby-info

# OpenRouter — used by standalone extraction scripts such as
# `node scripts/extract-mold-batches.ts <article-url>`.
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=https://old-baby-info.vercel.app
ALLOW_PAID_FALLBACK=false
